# csnp/cryptoscan (Go; regex scan of source + config -> JSON/SARIF/CBOM). Pinned commit.
FROM golang:1-alpine AS build
ARG COMMIT=22aad8a9a2046f5bbfdd3c89ea6327888f51bee0
RUN apk add --no-cache git
RUN git clone https://github.com/csnp/cryptoscan /src && git -C /src checkout "$COMMIT"
WORKDIR /src
RUN CGO_ENABLED=0 GOTOOLCHAIN=auto go build -ldflags="-s -w" -o /cryptoscan ./cmd/cryptoscan

FROM alpine:3
COPY --from=build /cryptoscan /usr/local/bin/cryptoscan
# the tool's own sample files, scanned too as a target set chosen by the competitor rather than by us
COPY --from=build /src/crypto-samples /samples
ENTRYPOINT ["cryptoscan"]
