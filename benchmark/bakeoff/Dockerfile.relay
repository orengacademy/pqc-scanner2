# Sidecar for tools that cannot take a custom port (QuantaSeek dials <target>:443 whatever the target says).
# It listens on 127.0.0.1:443 inside a private network namespace and relays to a unix socket that the
# host bridges to one loopback TLS endpoint. Not a scanner; socat is pinned to the Alpine package version.
FROM alpine:3@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache socat=1.8.1.3-r0
ENTRYPOINT ["socat"]
