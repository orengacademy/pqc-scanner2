# Mehrn0ush/QuantaSeek (Rust; active TLS 1.2/1.3, parses ServerHello). Pinned commit.
# The repo ships no Cargo.lock, so dependency versions float within Cargo.toml ranges; the resolved
# lockfile is copied next to the binary for the record.
#
# Two targets:  stock    the unmodified tool (plus the library-name fix below)
#               noverify the same tool with certificate and signature checks accepted (quantaseek-noverify.patch).
# Stock QuantaSeek verifies every server against the bundled public roots and the server name, with no flag to
# relax it, so it cannot complete a handshake with a private-CA or SAN-less server such as the corpus fixtures.
# The noverify build shows what its ServerHello parsing reports once that gate is out of the way.
FROM rust:1-slim@sha256:4df2ae8cfdfebdfc13a65da7f253b73d68983dc0339f2719bc17a279c913b13d AS build
ARG COMMIT=bb4a06a28c515dee86602dbd6002ca99e0b3312e
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates build-essential cmake \
    clang libclang-dev pkg-config libssl-dev && apt-get clean
RUN git clone https://github.com/Mehrn0ush/QuantaSeek /src && git -C /src checkout "$COMMIT"
WORKDIR /src
# Upstream defect at this commit: the package is named "QuantaSeek", so its library crate is "QuantaSeek",
# but main.rs imports `quanta_seek` (E0432/E0433). Name the library explicitly; no source file is changed.
RUN printf '\n[lib]\nname = "quanta_seek"\npath = "src/lib.rs"\n' >> Cargo.toml
RUN cargo build --release

FROM build AS build-noverify
COPY quantaseek-noverify.patch /tmp/quantaseek-noverify.patch
RUN git apply /tmp/quantaseek-noverify.patch && cargo build --release

FROM debian:stable-slim@sha256:eb593cf2c358cacef45ca0a424bbc7d30cfa3466265fc2662b9466a0ca6ba1c5 AS stock
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && apt-get clean
COPY --from=build /src/target/release/quantaseek /usr/local/bin/quantaseek
COPY --from=build /src/Cargo.lock /usr/share/quantaseek-Cargo.lock
ENTRYPOINT ["quantaseek"]

FROM debian:stable-slim@sha256:eb593cf2c358cacef45ca0a424bbc7d30cfa3466265fc2662b9466a0ca6ba1c5 AS noverify
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && apt-get clean
COPY --from=build-noverify /src/target/release/quantaseek /usr/local/bin/quantaseek
COPY --from=build /src/Cargo.lock /usr/share/quantaseek-Cargo.lock
ENTRYPOINT ["quantaseek"]
