<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="pqcscan fleet mode: the capacity and real-soak campaign's item verdicts, measured numbers and findings, each traced to the file it came from.">
<meta name="color-scheme" content="light dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Fira+Sans:wght@400;600;700&display=optional">
<title>Fleet Capacity Evidence</title>
<!-- Generated by `python -m benchmark.fleet.evidence_page` from the committed artefacts. Do not edit by hand. -->
<style>
:root {
  --bg: #f4f5f7; --surface: #fcfcfd; --text: #15181e; --muted: #4b5361; --line: #d8dce2; --line-soft: #e8eaee;
  --accent: #1d4ed8; --code-bg: #eceef2;
  --ok-bg: #dcf2e3; --ok-fg: #0f5a2b; --bad-bg: #fbe1df; --bad-fg: #962018;
  --wait-bg: #fbefd2; --wait-fg: #6e4600; --info-bg: #e2e8f6; --info-fg: #1e3a8a;
  --radius: 6px; --shade: rgb(21 24 30 / .2);
  --sans: "Fira Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: "Fira Code", ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1116; --surface: #151920; --text: #e5e8ec; --muted: #a2abb8; --line: #2b313b; --line-soft: #20252d;
    --accent: #8ab4ff; --code-bg: #1f242c;
    --ok-bg: #12331e; --ok-fg: #94e2ad; --bad-bg: #3b1513; --bad-fg: #ffb4ad;
    --wait-bg: #382906; --wait-fg: #f3c76f; --info-bg: #1a2440; --info-fg: #adc4ff; --shade: rgb(0 0 0 / .65);
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 var(--sans); }
.wrap { max-width: 76rem; margin: 0 auto; padding: 32px 16px 64px; }
a { color: var(--accent); text-underline-offset: 2px; }
::selection { background: var(--info-bg); color: var(--info-fg); }
html { scrollbar-color: var(--line) var(--bg); accent-color: var(--accent); }
a:focus-visible, .scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
code, .mono, td.num, .src { font-family: var(--mono); font-variant-numeric: tabular-nums; font-variant-ligatures: none; }
td.mono { white-space: nowrap; }
pre { overflow-x: auto; background: var(--code-bg); padding: 12px 14px; border-radius: 6px; font-size: .85em; }
pre code { background: none; padding: 0; }
code { font-size: .88em; background: var(--code-bg); padding: 1px 4px; border-radius: 4px; }
h1 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); line-height: 1.15; margin: 0 0 8px; letter-spacing: -.01em; }
h2 { font-size: 1.4rem; line-height: 1.25; margin: 0 0 6px; letter-spacing: -.005em; }
h3 { font-size: 1.05rem; margin: 24px 0 6px; }
p { margin: 0 0 10px; max-width: 72ch; }
.lede { color: var(--muted); }
header { margin-bottom: 20px; }
nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 0; margin: 12px 0 0; font-size: .9rem; }
.tag { border: 1px solid var(--bad-fg); background: var(--bad-bg); color: var(--bad-fg);
  border-radius: var(--radius); padding: 14px 16px; margin: 0 0 24px; }
.tag.clear { border-color: var(--ok-fg); background: var(--ok-bg); color: var(--ok-fg); }
.tag strong { display: block; font-size: 1.05rem; margin-bottom: 2px; }
.tag p { margin: 0; }
section { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 16px 12px;
  margin: 0 0 20px; }
section > p:first-of-type { color: var(--muted); font-size: .92rem; }
/* scroll shadows: an edge darkens while more columns hide past it (CSS only, background-attachment local) */
.scroll { overflow-x: auto; margin: 8px 0 12px;
  background: linear-gradient(to right, var(--surface) 30%, transparent) left / 40px 100% no-repeat local,
    linear-gradient(to left, var(--surface) 30%, transparent) right / 40px 100% no-repeat local,
    radial-gradient(farthest-side at 0 50%, var(--shade), transparent) left / 12px 100% no-repeat scroll,
    radial-gradient(farthest-side at 100% 50%, var(--shade), transparent) right / 12px 100% no-repeat scroll; }
table { border-collapse: collapse; width: 100%; font-size: .9rem; }
th, td { text-align: left; vertical-align: top; padding: 7px 10px 7px 0; }
th { font-size: .78rem; font-weight: 600; color: var(--muted); border-bottom: 1px solid var(--line); white-space: nowrap; }
tbody tr + tr td { border-top: 1px solid var(--line-soft); }
td.num, th.num { text-align: right; white-space: nowrap; }
td.src { font-size: .75rem; color: var(--muted); overflow-wrap: break-word; min-width: 10rem; max-width: 22rem; }
td.wide { min-width: 18rem; }
td .pill.long { white-space: normal; border-radius: var(--radius); max-width: 16rem; }
.pill { display: inline-block; font: 600 .76rem/1.5 var(--sans); padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
.ok { background: var(--ok-bg); color: var(--ok-fg); }
.bad { background: var(--bad-bg); color: var(--bad-fg); }
.wait { background: var(--wait-bg); color: var(--wait-fg); }
.info { background: var(--info-bg); color: var(--info-fg); }
.empty { color: var(--wait-fg); background: var(--wait-bg); border-radius: var(--radius); padding: 8px 12px; font-size: .9rem; }
.frames { margin: 0; padding-left: 18px; }
.frames li { overflow-wrap: anywhere; }
.frames .mono { color: var(--muted); }
footer { color: var(--muted); font-size: .85rem; margin-top: 28px; }
/* text-heavy tables stack into labelled blocks on phones instead of scrolling sideways */
@media (max-width: 720px) {
  table.stack thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  table.stack tr { display: block; padding: 10px 0; }
  table.stack tbody tr + tr td { border-top: 0; }
  table.stack tbody tr + tr { border-top: 1px solid var(--line); }
  table.stack td { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 8px; padding: 3px 0; text-align: left; }
  table.stack td > .pill { justify-self: start; }
  table.stack td::before { content: attr(data-label); font: 600 .78rem/1.7 var(--sans); color: var(--muted); }
  table.stack td.src, table.stack td.wide { min-width: 0; max-width: none; }
  section { padding: 16px 12px 8px; }
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>Fleet capacity evidence</h1>
  <p class="lede">pqcscan fleet mode, branch <code>verify/fleet-capacity</code>. Every number on this page comes from the file named in its source cell.
    The graded claims and their wording live in <a href="../FLEET-EVIDENCE.md">FLEET-EVIDENCE.md</a>.</p>
  <nav aria-label="Sections"><ul>
    <li><a href="#items">Items</a></li><li><a href="#since">Since PR #92</a></li><li><a href="#capacity">Capacity</a></li>
    <li><a href="#profiles">Profiles</a></li><li><a href="#soak">Soak</a></li><li><a href="#strength">Test strength</a></li>
    <li><a href="#ci">CI baseline</a></li><li><a href="#ui">Web UI</a></li><li><a href="#findings">Findings</a></li>
  </ul></nav>
</header>

<main>
<div class="tag{{ ' clear' if d.tag_ok }}" role="status">
  <strong>{{ 'Tag decision: release allowed' if d.tag_ok else 'Tag decision: hold the release' }}</strong>
  <p>{{ d.tag }}</p>
</div>

<section id="items" aria-labelledby="items-h">
  <h2 id="items-h">Spec items</h2>
  <p>The six items of the capacity and real-soak spec. The tag waits until items 1 to 4 hold.</p>
  <div class="scroll"><table class="stack">
    <thead><tr><th>#</th><th>Item</th><th>Verdict</th><th>Basis</th><th>Source</th></tr></thead>
    <tbody>
    {% for i in d['items'] %}
    <tr class="item"><td data-label="#" class="num">{{ i.n }}</td><td data-label="Item">{{ i.item }}</td>
      <td data-label="Verdict"><span class="pill {{ i.kind }}">{{ i.verdict }}</span></td>
      <td data-label="Basis">{{ i.basis }}</td><td data-label="Source" class="src">{{ i.source|wbr }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

<section id="since" aria-labelledby="since-h">
  <h2 id="since-h">Since PR #92</h2>
  {% if d.since %}
  <p>The item verdicts, the regraded claims and the acceptance grading, copied from the "Since PR #92" section of FLEET-EVIDENCE.md.</p>
  {% for t in d.since %}
  <div class="scroll" role="region" aria-label="Since PR #92, table {{ loop.index }}" tabindex="0"><table class="stack">
    <thead><tr>{% for h in t[0] %}<th>{{ h|md }}</th>{% endfor %}</tr></thead>
    <tbody>{% for r in t[1:] %}<tr>{% for c in r %}<td data-label="{{ t[0][loop.index0] }}">{{ c|md }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
  {% endfor %}
  {% if d.commands %}
  <h3>Commands a stranger runs</h3>
  <p>To finish the soak and to reproduce the capacity number, copied from FLEET-EVIDENCE.md.</p>
  <pre tabindex="0" aria-label="Reproduction commands"><code>{{ d.commands }}</code></pre>
  {% endif %}
  {% else %}
  <p class="empty">Pending. The "Since PR #92" section of docs/FLEET-EVIDENCE.md is not written yet; regenerate this page after it is.</p>
  {% endif %}
</section>

<section id="capacity" aria-labelledby="cap-h">
  <h2 id="cap-h">Ingest capacity</h2>
  <p>λ_max is the largest swept rate where both seeds keep p95 under 2 s with a sound measurement; the band's upper edge is the lowest rate where a seed fails. Hosts per day assume a daily timer with a 2 h jitter, or posts spread over 24 h.</p>
  {% if d.capacity %}
  <div class="scroll" role="region" aria-label="Capacity per backend" tabindex="0"><table>
    <thead><tr><th>Backend</th><th class="num">λ_max posts/s</th><th class="num">Band</th><th class="num">Hosts/day, 2 h</th><th class="num">Hosts/day, 24 h</th><th class="num">Runs</th><th>Source</th></tr></thead>
    <tbody>
    {% for db, c in d.capacity.items() %}
    <tr class="cap"><td>{{ db }}</td>{% if c.lambda_max is none %}<td class="num">none passed</td><td class="num">lowest failure {{ c.band[1]|g }}</td>{% else %}<td class="num">{{ c.lambda_max|g }}</td><td class="num">{{ c.band[0]|g }} to {{ c.band[1]|g }}</td>{% endif %}
      <td class="num">{{ c.hosts_daily_2h|n }}</td><td class="num">{{ c.hosts_daily_24h|n }}</td><td class="num">{{ c.rows|length }}</td>
      <td class="src">{{ ("benchmark/fleet/results/load-" ~ db ~ "-*-sweep*.json")|wbr }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <h3>Sweep runs</h3>
  <div class="scroll" role="region" aria-label="Sweep runs" tabindex="0"><table>
    <thead><tr><th>Backend</th><th class="num">Rate</th><th class="num">Seed</th><th class="num">p95 ms</th><th class="num">Achieved rps</th><th class="num">Little ratio</th><th>Result</th><th>Source</th></tr></thead>
    <tbody>
    {% for db, c in d.capacity.items() %}{% for r in c.rows %}
    <tr><td>{{ db }}</td><td class="num">{{ r.offered_rps|g }}</td><td class="num">{{ r.seed }}</td><td class="num">{{ r.p95_ms|n('{:,.0f}') }}</td>
      <td class="num">{{ r.rps|g }}</td><td class="num">{{ r.littles_ratio|g }}</td><td>{{ verdict(r) }}</td><td class="src">{{ r._src|wbr }}</td></tr>
    {% endfor %}{% endfor %}
    </tbody>
  </table></div>
  {% set sup = d.capacity.values()|map(attribute='superseded')|map('length')|sum %}
  {% if sup %}
  <p>{{ sup }} more sweep runs, at the old 4-slot Postgres default, are not counted. They are listed in CAPACITY.md under superseded runs.</p>
  {% endif %}
  {% else %}
  <p class="empty">Pending. No <code>-sweep</code> result files exist yet, so no backend has a capacity number.</p>
  {% endif %}

  <h3>Herd, all 500 hosts at once</h3>
  {% if d.results['-herd'] %}
  <div class="scroll" role="region" aria-label="Herd runs" tabindex="0"><table>
    <thead><tr><th>Backend</th><th class="num">Requests</th><th class="num">503</th><th class="num">Unanswered</th><th class="num">p95 ms</th><th>Result</th><th>Source</th></tr></thead>
    <tbody>{% for r in d.results['-herd'] %}
    <tr><td>{{ r.db }}</td><td class="num">{{ r.requests|n }}</td><td class="num">{{ r.http_503|n }}</td><td class="num">{{ r|unanswered|n }}</td>
      <td class="num">{{ r.p95_ms|n('{:,.0f}') }}</td><td>herd: Little's law not applicable</td><td class="src">{{ r._src|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No schema-2 herd result exists yet.</p>
  {% endif %}

  <h3>Postgres ingest parallelism</h3>
  {% if d.results['-par'] %}
  <div class="scroll" role="region" aria-label="Postgres parallelism runs" tabindex="0"><table>
    <thead><tr><th>Backend</th><th class="num">Slots</th><th class="num">Rate</th><th class="num">Seed</th><th class="num">p95 ms</th><th class="num">Achieved rps</th><th class="num">Little ratio</th><th class="num">503</th><th>Result</th><th>Source</th></tr></thead>
    <tbody>{% for r in d.results['-par']|sort(attribute='_file') %}
    <tr><td>{{ r.db }}</td><td class="num">{{ r.ingest_parallelism|n }}</td><td class="num">{{ r.offered_rps|g }}</td><td class="num">{{ r.seed }}</td><td class="num">{{ r.p95_ms|n('{:,.0f}') }}</td>
      <td class="num">{{ r.rps|g }}</td><td class="num">{{ r.littles_ratio|g }}</td><td class="num">{{ r.http_503|n }}</td><td>{{ verdict(r) }}</td><td class="src">{{ r._src|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No parallelism results exist yet.</p>
  {% endif %}

  <h3>Postgres insert strategy, 500 hosts at 4 posts/s</h3>
  {% if d.results['-pginsert'] %}
  <div class="scroll" role="region" aria-label="Postgres insert strategy runs" tabindex="0"><table>
    <thead><tr><th>Insert</th><th class="num">Slots</th><th class="num">p95 ms</th><th class="num">Achieved rps</th><th class="num">Stored scans</th><th class="num">503</th><th>Result</th><th>Source</th></tr></thead>
    <tbody>{% for r in d.results['-pginsert']|sort(attribute='_file') %}
    <tr><td>{{ r.insert_mode or '-' }}</td><td class="num">{{ r.ingest_parallelism|n }}</td><td class="num">{{ r.p95_ms|n('{:,.0f}') }}</td>
      <td class="num">{{ r.rps|g }}</td><td class="num">{{ r.stored_scans|n }}</td><td class="num">{{ r.http_503|n }}</td><td>{{ verdict(r) }}</td><td class="src">{{ r._src|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No insert-strategy results exist yet.</p>
  {% endif %}
</section>

<section id="profiles" aria-labelledby="prof-h">
  <h2 id="prof-h">Profiles before and after the fixes</h2>
  <p>500 hosts at 4 posts/s with 1,670-finding bundles on the 8-vCPU load box, 300 s per run. Profiled runs carry asyncio debug overhead, so their latencies are not capacity numbers. Frames show self share of sampled wall time. Latency counts accepted ingests only (answered 200), from each run's per-request CSV: the 503s the queue sheds would pull a median over every response down.</p>
  {% if d.profiles %}
  <div class="scroll" role="region" aria-label="Profiles" tabindex="0"><table>
    <thead><tr><th>Backend</th><th>Side</th><th>Top three frames, self %</th><th class="num">Statements per ingest</th><th class="num">Stored scans</th><th class="num">Accepted p50 ms</th><th class="num">Accepted p95 ms</th><th>Source</th></tr></thead>
    <tbody>
    {% for db, sides in d.profiles.items() %}{% for side in ['before', 'after'] if side in sides %}{% set p = sides[side] %}
    <tr><td>{{ db }}</td><td>{{ side }}</td>
      <td><ol class="frames">{% for f in p.top %}<li><code>{{ f.frame }}</code> <span class="mono">{{ '%.1f'|format(f.self_pct) }}</span></li>{% endfor %}</ol></td>
      <td class="num">{{ p.statements_per_ingest|n('{:,.1f}') }}</td><td class="num">{{ p.stored_scans|n }}</td>
      <td class="num">{{ p.p50_accepted_ms|n('{:,.0f}') }}</td><td class="num">{{ p.p95_accepted_ms|n('{:,.0f}') }}</td>
      <td class="src">{{ p.source|wbr }}{% if p.run_source %}, {{ p.run_source|wbr }}{% endif %}</td></tr>
    {% endfor %}{% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No profile summaries exist yet.</p>
  {% endif %}
</section>

<section id="soak" aria-labelledby="soak-h">
  <h2 id="soak-h">Real soak</h2>
  {% if d.soak.start %}
  <p>Started {{ d.soak.start }}. Day {{ d.soak.day }} is the newest sample on record; day 7 falls on {{ d.soak.day7 }}.
    {% if not d.soak.windows %}The Windows runners join when PR #93 merges.{% endif %} IBM i is untested.</p>
  {% else %}
  <p class="empty">Pending. No real soak samples exist yet.</p>
  {% endif %}
  {% if d.soak.hosts %}
  <div class="scroll" role="region" aria-label="Soak hosts" tabindex="0"><table>
    <thead><tr><th>Host</th><th>Role</th><th class="num">Samples</th><th>First sample, UTC</th><th>Last sample, UTC</th><th class="num">Spool files</th><th class="num">DB or state bytes</th><th class="num">Scans</th><th>Source</th></tr></thead>
    <tbody>
    {% for h in d.soak.hosts %}
    <tr><td>{{ h.host }}</td><td>{{ h.role }}</td><td class="num">{{ h.samples }}</td><td class="mono">{{ h.first }}</td><td class="mono">{{ h.last }}</td>
      <td class="num">{{ h.spool or '-' }}</td><td class="num">{{ h.bytes|n }}</td><td class="num">{{ h.scans or '-' }}</td><td class="src">{{ h.source|wbr }}</td></tr>
    {% endfor %}
    {% if not d.soak.windows %}
    <tr><td>windows-2022, windows-latest</td><td>agent</td><td class="num">-</td><td colspan="5"><span class="pill wait">pending</span> joins when PR #93 merges</td><td class="src">{{ "benchmark/fleet/soak-real.md"|wbr }}</td></tr>
    {% endif %}
    </tbody>
  </table></div>
  {% endif %}
  {% if d.soak.observe %}{% set o = d.soak.observe %}
  <h3>Collector, <code>soak --observe</code></h3>
  <div class="scroll" role="region" aria-label="Collector observation" tabindex="0"><table>
    <thead><tr><th class="num">Hosts enrolled</th><th class="num">Scans</th><th class="num">Drift rows</th><th>Ingest statuses</th><th>Enrol statuses</th><th>Source</th></tr></thead>
    <tbody><tr><td class="num">{{ o.hosts_enrolled|n }}</td><td class="num">{{ o.scans_total|n }}</td><td class="num">{{ o.drift_rows_total|n }}</td>
      <td class="mono">{% for k, v in (o.statuses.ingest or {}).items() %}{{ k }}: {{ v }} {% endfor %}</td>
      <td class="mono">{% for k, v in (o.statuses.enroll or {}).items() %}{{ k }}: {{ v }} {% endfor %}</td><td class="src">{{ o.source|wbr }}</td></tr></tbody>
  </table></div>
  {% endif %}
</section>

<section id="strength" aria-labelledby="str-h">
  <h2 id="str-h">Test strength</h2>
  <p>atheris on <code>load_bundle</code>, with coverage from replaying the merged corpus, and mutmut on the fleet collector and bundle loader.</p>
  {% if d.fuzz %}
  <div class="scroll" role="region" aria-label="Fuzz harnesses" tabindex="0"><table>
    <thead><tr><th>Harness</th><th class="num">CPU hours</th><th class="num">Executions</th><th class="num">Crashes</th><th class="num">Corpus files</th><th>Source</th></tr></thead>
    <tbody>{% for h in d.fuzz.harnesses %}
    <tr><td>{{ h.harness }}</td><td class="num">{{ '%.1f'|format(h.cpu_seconds / 3600) }}</td><td class="num">{{ h.execs|n }}</td><td class="num">{{ h.crashes }}</td>
      <td class="num">{{ h.corpus_files }}</td><td class="src">{{ "benchmark/fleet/fuzz/stats.json"|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% if d.fuzz.coverage %}
  <div class="scroll" role="region" aria-label="Corpus coverage" tabindex="0"><table>
    <thead><tr><th>File</th><th class="num">Statements</th><th class="num">Missed</th><th class="num">Covered</th><th>Source</th></tr></thead>
    <tbody>{% for c in d.fuzz.coverage %}
    <tr><td><code>{{ c.file }}</code></td><td class="num">{{ c.stmts }}</td><td class="num">{{ c.miss }}</td><td class="num">{{ c.cover }} %</td><td class="src">{{ "benchmark/fleet/fuzz/coverage.txt"|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% endif %}
  {% else %}
  <p class="empty">Pending. No fuzz stats exist yet.</p>
  {% endif %}
  <h3>Mutation testing</h3>
  {% if d.mutation %}{% set m = d.mutation %}
  <div class="scroll" role="region" aria-label="Mutation score" tabindex="0"><table>
    <thead><tr><th class="num">Score</th><th class="num">Killed</th><th class="num">Survived</th><th class="num">Timeout</th><th class="num">Total</th><th>Source</th></tr></thead>
    <tbody><tr><td class="num">{{ '%.1f'|format(m.score * 100) }} %</td><td class="num">{{ m.killed|n }}</td><td class="num">{{ m.survived|n }}</td>
      <td class="num">{{ m.timeout|n }}</td><td class="num">{{ m.total|n }}</td><td class="src">{{ "benchmark/fleet/mutation/score.json"|wbr }}</td></tr></tbody>
  </table></div>
  {% if d.mutation_adjusted %}{% set a = d.mutation_adjusted %}
  <p>Adjusted score {{ '%.3f'|format(a.score) }} = {{ a.killed }} / {{ a.denominator }}, {{ a.rule }}: the raw run plus the mutants the new tests kill, over the mutants that are not equivalent{% if a.counts %} ({{ a.counts }}){% endif %}. Source: <span class="src">{{ "benchmark/fleet/mutation/MUTATION.md"|wbr }}</span>.</p>
  {% endif %}
  {% else %}
  <p class="empty">Pending. The mutmut run was relaunched and <code>benchmark/fleet/mutation/score.json</code> does not exist yet.</p>
  {% endif %}
</section>

<section id="ci" aria-labelledby="ci-h">
  <h2 id="ci-h">CI load-ratio baseline</h2>
  <p>Same-runner A/B on ubuntu-latest: base 77867a1 against the branch head, 1,670-finding bundles{% if d.ci_runs.load_ratio_first_green %}, CI run {{ d.ci_runs.load_ratio_first_green.run }} at {{ d.ci_runs.load_ratio_first_green.commit }}{% endif %}. The ratio is head p95 over base p95.</p>
  {% if d.ci %}
  <div class="scroll" role="region" aria-label="CI baseline" tabindex="0"><table>
    <thead><tr><th>Backend</th><th class="num">Hosts</th><th class="num">Posts/s</th><th class="num">Base p95 ms</th><th class="num">Head p95 ms</th><th class="num">Ratio</th><th class="num">Achieved rps</th><th>Source</th></tr></thead>
    <tbody>{% for r in d.ci %}
    <tr><td>{{ r.db }}</td><td class="num">{{ r.hosts|n }}</td><td class="num">{{ r.offered_rps|g }}</td><td class="num">{{ r.base_p95_ms|n('{:,.0f}') }}</td>
      <td class="num">{{ r.p95_ms|n('{:,.0f}') }}</td><td class="num">{{ r.ratio|n('{:.2f}x') }}</td><td class="num">{{ r.rps|g }}</td><td class="src">{{ r.source|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No CI baseline files exist yet.</p>
  {% endif %}
</section>

<section id="ui" aria-labelledby="ui-h">
  <h2 id="ui-h">Web UI and exports at 500 hosts</h2>
  <p>Median of three loads on a shared, loaded workstation, so the timings are relative. The CBOM export ran once.</p>
  {% if d.ui %}
  <div class="scroll" role="region" aria-label="Web UI timings" tabindex="0"><table>
    <thead><tr><th>Page or endpoint</th><th>Measured to</th><th class="num">Seconds</th><th class="num">Bytes</th><th>Source</th></tr></thead>
    <tbody>{% for r in d.ui %}
    <tr><td><code>{{ r.what }}</code></td><td>{{ r.kind }}</td><td class="num">{{ r.seconds|n('{:,.2f}') }}</td><td class="num">{{ r.bytes|n }}</td><td class="src">{{ r.source|wbr }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No UI timings exist yet.</p>
  {% endif %}
</section>

<section id="findings" aria-labelledby="find-h">
  <h2 id="find-h">Findings</h2>
  <p>From the findings table in FLEET-EVIDENCE.md. The full text of each finding is there.</p>
  {% if d.findings %}
  <div class="scroll"><table class="stack">
    <thead><tr><th>ID</th><th>Finding</th><th>Severity</th><th>State</th><th>Source</th></tr></thead>
    <tbody>{% for f in d.findings %}
    <tr><td data-label="ID" class="mono">{{ f.id }}</td><td data-label="Finding" class="wide">{{ f.title }}</td><td data-label="Severity">{{ f.severity }}</td>
      <td data-label="State"><span class="pill {{ f.state|kind }}{{ ' long' if f.state|length > 24 }}">{{ f.state }}</span></td><td data-label="Source" class="src">{{ f.source|md }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}
  <p class="empty">Pending. No findings table was found in docs/FLEET-EVIDENCE.md.</p>
  {% endif %}
</section>
</main>

<footer>
  <p>Regenerate with <code>python -m benchmark.fleet.evidence_page</code>. Missing inputs show as pending; nothing on this page is edited by hand.</p>
</footer>
</div>
</body>
</html>
